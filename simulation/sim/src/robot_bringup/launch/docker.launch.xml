<launch>
    <set_env
    name="GZ_SIM_RESOURCE_PATH"
    value="$(env GZ_SIM_RESOURCE_PATH ''):$(find-pkg-prefix robot_description)/share:$(find-pkg-prefix robot_bringup)/share" />
    <let name="urdf_path" 
         value="$(find-pkg-share robot_description)/urdf/real_corexy.xacro"/>
    
    <let name="world_path" 
         value="$(find-pkg-share robot_bringup)/world/corexy.sdf"/>

    <let name="gui_gz_conf_path" 
         value="$(find-pkg-share robot_bringup)/config/gui_gazebo.config"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <include file="$(find-pkg-share ros_gz_bridge)/launch/clock_bridge.launch">
        <arg name="bridge_name" value="clock_bridge"/>
    </include>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r --gui-config $(var gui_gz_conf_path)"/>
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
          args="joint_state_broadcaster --controller-manager /controller_manager --controller-manager-timeout 120"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
          args="motor_position_controller --controller-manager /controller_manager --controller-manager-timeout 120"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
          args="belt_position_controller --controller-manager /controller_manager --controller-manager-timeout 120"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
          args="xy_position_controller --controller-manager /controller_manager --controller-manager-timeout 120"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
          args="z_position_controller --controller-manager /controller_manager --controller-manager-timeout 120"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
          args="gripper_position_controller --controller-manager /controller_manager --controller-manager-timeout 120"/>
    
    <node pkg="controller_manager" exec="spawner" output="screen"
          args="click_position_controller --controller-manager /controller_manager --controller-manager-timeout 120"/>

    <node pkg="robot_kinematics" exec="motor_to_corexy" output="screen">
        <param from="$(find-pkg-share robot_bringup)/config/corexy_kinematics.yaml"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="robot_kinematics" exec="distance_to_radians" output="screen">
        <param from="$(find-pkg-share robot_bringup)/config/corexy_kinematics.yaml"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="robot_kinematics" exec="belt" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="robot_kinematics" exec="gripper" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="robot_kinematics" exec="move_z" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="robot_kinematics" exec="mouse_click" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="rosbridge_server" exec="rosbridge_websocket" output="screen">
        <param name="port" value="9090"/>
    </node>
    
</launch>
