                <mesh filename="package://robot_description/meshes/wozek_szyna.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>

    <link name="monter_srodek">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 ${-pi/2.0}" />
            <mass value="0.35171484845720885" />
            <inertia ixx="8.541507879374945e-05" iyy="7.55066209638458e-05" izz="0.00011247705556501758" ixy="2.940906108916952e-09" iyz="2.228922612617333e-06" ixz="1.152349197097377e-08" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${-pi/2.0}" />
            <geometry>
                <mesh filename="package://robot_description/meshes/monter_z.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="green" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 ${-pi/2.0}" />
            <geometry>
                <mesh filename="package://robot_description/meshes/monter_z.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>



    <joint name="base_link_podstawa_prawa" type="fixed">
        <parent link="base_link" />
        <child link="podstawa_prawa" />
        <origin xyz="${-base_length/2.0+0.006} ${base_width/2.0-0.04-0.0085} ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_link_podstawa_lewa" type="fixed">
        <parent link="base_link" />
        <child link="podstawa_lewa" />
        <origin xyz="${-base_length/2.0+0.006} ${-base_width/2.0+0.04+0.0085} ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_link_podstawa_silnik_prawa" type="fixed">
        <parent link="base_link" />
        <child link="podstawa_silnik_prawa" />
        <origin xyz="${base_length/2.0-0.0148} ${base_width/2.0-0.049} ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="base_link_podstawa_silnik_lewa" type="fixed">
        <parent link="base_link" />
        <child link="podstawa_silnik_lewa" />
        <origin xyz="${base_length/2.0-0.0148} ${-base_width/2.0+0.049} ${base_height}" rpy="0 0 0" />
    </joint>

    <joint name="podstawa_silnik_prawa_nema_23_prawa" type="fixed">
        <parent link="podstawa_silnik_prawa" />
        <child link="nema23_prawa" />
        <origin xyz="0 0 0.171" rpy="0 0 0" />
    </joint>

    <joint name="podstawa_silnik_lewa_nema_23_lewa" type="fixed">
        <parent link="podstawa_silnik_lewa" />
        <child link="nema23_lewa" />
        <origin xyz="0 0 0.171" rpy="0 0 0" />
    </joint>

    <joint name="podstawa_silink_lewa_profil_przod" type="fixed">
        <parent link="podstawa_silnik_lewa" />
        <child link="profil_przod" />
        <origin xyz="0 0 0.171" rpy="0 0 0" />
    </joint>

    <joint name="podstawa_silink_prawa_profil_prawy" type="fixed">
        <parent link="podstawa_silnik_prawa" />
        <child link="profil_prawy" />
        <origin xyz="0 0 0.171" rpy="0 0 0" />
    </joint>

    <joint name="podstawa_prawa_profil_tyl" type="fixed">
        <parent link="podstawa_prawa" />
        <child link="profil_tyl" />
        <origin xyz="0 0 0.171" rpy="0 0 0" />
    </joint>

    <joint name="podstawa_lewa_profil_lewy" type="fixed">
        <parent link="podstawa_lewa" />
        <child link="profil_lewy" />
        <origin xyz="0 0 0.171" rpy="0 0 0" />
    </joint>

    <joint name="profil_prawy_szyna_prawa" type="fixed">
        <parent link="profil_prawy" />
        <child link="szyna_prawa" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="profil_lewy_szyna_lewa" type="fixed">
        <parent link="profil_lewy" />
        <child link="szyna_lewa" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="motorA_joint" type="continuous">
        <parent link="nema23_prawa" />
        <child link="zebatka_prawa" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit effort="30.0" velocity="50.0"/>
    </joint>

    <joint name="motorB_joint" type="continuous">
        <parent link="nema23_lewa" />
        <child link="zebatka_lewa" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit effort="30.0" velocity="50.0"/>
    </joint>

    <joint name="x_axis_joint" type="prismatic">
        <parent link="szyna_prawa"/>
        <child link="wozek_prawy"/>

        <origin xyz="-0.2525 0 0" rpy="0 0 0" />
        
        <limit lower="-0.1475" 
               upper="0.1475"
               effort="10.0" velocity="3.0"/>
        <axis xyz="1 0 0"/>
    </joint>

    <joint name="wozek_prawy_monter_prawy" type="fixed">
        <parent link="wozek_prawy" />
        <child link="monter_prawy" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="monter_prawy_szyna_srodek" type="fixed">
        <parent link="monter_prawy" />
        <child link="szyna_srodek" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="szyna_srodek_monter_lewy" type="fixed">
        <parent link="szyna_srodek" />
        <child link="monter_lewy" />
        <origin xyz="0 -0.42 0" rpy="0 0 0" />
    </joint>

    <joint name="monter_lewy_wozek_lewy" type="fixed">
        <parent link="monter_lewy" />
        <child link="wozek_lewy" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="y_axis_joint" type="prismatic">
        <parent link="szyna_srodek" />
        <child link="wozek_srodek" />
        <origin xyz="0.009 -0.21 -0.0175" rpy="0 0 0" />
        <limit lower="-0.13" 
               upper="0.13"
               effort="10.0" velocity="3.0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="wozek_srodek_monter_srodek" type="fixed">
        <parent link="wozek_srodek" />
        <child link="monter_srodek" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

     <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="motorA_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="motorB_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="x_axis_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="y_axis_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(find robot_bringup)/config/motor_controllers.yaml</parameters>
            <controller_manager_prefix_node_name>controller_manager</controller_manager_prefix_node_name>
            <hold_joints>true</hold_joints>
            <position_proportional_gain>1.0</position_proportional_gain>
            <position_integral_gain>0.0</position_integral_gain>
            <position_derivative_gain>0.0</position_derivative_gain>

        </plugin>
    </gazebo>

</robot>
