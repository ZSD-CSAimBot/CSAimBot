<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_width" value="0.5178" />
    <xacro:property name="base_length" value="0.4838" />
    <xacro:property name="base_height" value="0.04" />


    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1" />
    </material>

     <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1" />
    </material>

    <material name="yellow">
        <color rgba="1.0 1.0 0.0 1" />
    </material>

    <material name="red">
        <color rgba="1.0 0.0 0.0 1" />
    </material>

    <xacro:include filename="$(find robot_description)/urdf/links_macro.xacro"/>

    <xacro:pret_fi5 prefix="1" />
    <xacro:pret_fi5 prefix="2" />
    <xacro:pret_fi5 prefix="3" />
    <xacro:pret_fi5 prefix="4" />
    <xacro:pret_fi5 prefix="5" />
    <xacro:pret_fi5 prefix="6" />

    <xacro:rolka_gladka prefix="a"/>
    <xacro:rolka_gladka prefix="b"/>

    <xacro:rolka_zebata prefix="a_1"/>
    <xacro:rolka_zebata prefix="a_2"/>
    <xacro:rolka_zebata prefix="a_3"/>

    <xacro:rolka_zebata prefix="b_1"/>
    <xacro:rolka_zebata prefix="b_2"/>
    <xacro:rolka_zebata prefix="b_3"/>

    <xacro:pret_fi3 prefix="1" origin_xyz="0.0125 -0.025 -0.013" origin_rpy="0 0 0" />
    <xacro:pret_fi3 prefix="2" origin_xyz="0.0516 0.025 -0.013" origin_rpy="0 0 ${pi}" />
    <xacro:pret_fi3 prefix="3" origin_xyz="0.0394 0.0195  0.02" origin_rpy="${-pi/2.0} 0 0" />
    <xacro:pret_fi3 prefix="4" origin_xyz="0.0394 -0.0195  0.02" origin_rpy="${-pi/2.0} 0 0" />

    
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            <mass value="10"/>
            <inertia ixx="${(10/12.0) * (base_height*base_height + base_length*base_length)}" ixy="0.0" ixz="0.0" 
                     iyy="${(10/12.0) * (base_width*base_width + base_height*base_height)}" iyz="0.0" 
                     izz="${(10/12.0) * (base_width*base_width + base_length*base_length)}"/>
        </inertial>
        <visual>
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual> 
        <collision>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}" />
            </geometry>
        </collision>
    </link>

    <link name="podstawa_prawa">
        <inertial>
            <origin xyz="0 0.042 0.167" rpy="0 0 ${-pi/2.0}" />
            <mass value="0.11223308489437728" />
            <inertia ixx="0.00041028645624052035" iyy="6.286050337893367e-05" izz="0.0004102865492015828" ixy="-5.945579440957277e-06" iyz="5.944881698247313e-06" ixz="-7.289346889472609e-06" />
        </inertial>
        <visual>
            <origin xyz="0 0.042 0.167" rpy="${-pi/2.0} 0 ${-pi/2.0}" />
            <geometry>
                <mesh filename="package://robot_description/meshes/podstawa.stl" scale="0.001 0.001 0.001" />
            </geometry>${-pi/2.0}
            <material name="yellow" />
        </visual>
        <collision>
            <origin xyz="0 0.042 0.167" rpy=" ${-pi/2.0} 0 ${-pi/2.0}" />
