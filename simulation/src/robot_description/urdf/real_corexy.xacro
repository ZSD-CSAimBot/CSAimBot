<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_width" value="0.5178" />
    <xacro:property name="base_length" value="0.4838" />
    <xacro:property name="base_height" value="0.04" />


    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1" />
    </material>

     <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1" />
    </material>

    <material name="green">
        <color rgba="0 0.6 0 1" />
    </material>
    
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            <mass value="10"/>
            <inertia ixx="${(10/12.0) * (base_height*base_height + base_length*base_length)}" ixy="0.0" ixz="0.0" 
                     iyy="${(10/12.0) * (base_width*base_width + base_height*base_height)}" iyz="0.0" 
                     izz="${(10/12.0) * (base_width*base_width + base_length*base_length)}"/>
        </inertial>
        <visual>
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual> 
        <collision>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}" />
            </geometry>
        </collision>
    </link>

